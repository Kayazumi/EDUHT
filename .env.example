# [CFG] Mẫu cấu hình biến môi trường · tài liệu mục 8.1 và 8.6
# Lưu ý: Tệp này chỉ chứa tên biến mẫu, không chứa giá trị bí mật hay mật khẩu thật.

# URL dự án Supabase (Công khai - Client & Server)
NEXT_PUBLIC_SUPABASE_URL=

# Khóa công khai Supabase (Công khai - Client & Server; an toàn với RLS; có thể mang tên NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Địa chỉ URL trang web (Công khai - Metadata)
NEXT_PUBLIC_SITE_URL=

# Khóa dịch vụ Supabase bỏ qua RLS (BÍ MẬT - Chỉ dùng phía máy chủ; có thể mang tên SUPABASE_SECRET_KEY; tuyệt đối không gắn NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Tên miền giả để ghép email nội bộ cho tài khoản học sinh (Nội bộ máy chủ, ví dụ: hs.pbl.example)
STUDENT_EMAIL_DOMAIN=

# Khóa bí mật xác thực lời gọi Vercel Cron (BÍ MẬT - Dùng tại route cron keepalive)
CRON_SECRET=

# Khóa HMAC tạo mã giả khi xuất dữ liệu nghiên cứu (BÍ MẬT - Không xoay khóa trong suốt nghiên cứu)
EXPORT_PSEUDONYM_SECRET=

# Phiên bản khóa HMAC sinh mã giả (Nội bộ máy chủ)
EXPORT_PSEUDONYM_KEY_VERSION=1
